.system-main{max-width:1800px;margin:auto;padding:22px}.system-topbar{align-items:center}.brand-area{display:flex;align-items:center;gap:20px}
.system-toolbar{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:15px}.system-toolbar h2{font-size:19px}.system-toolbar p,.panel-heading p{font-size:12px;color:var(--muted);margin-top:4px}.toolbar-actions{display:flex;gap:8px;flex-wrap:wrap}
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:15px}.stat-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:14px}.stat-card strong{font-size:20px}.stat-card span{display:block;font-size:10px;color:var(--muted);margin-top:2px}
.panel{padding:20px;margin-bottom:15px}.panel-heading{margin-bottom:17px}.panel-heading h2{font-size:18px}.appearance-form{display:grid;grid-template-columns:1.5fr .8fr .9fr auto;gap:10px;align-items:end}.form-button{height:40px}
.teams-list{display:flex;flex-wrap:wrap;gap:8px}.team-card{display:flex;align-items:center;gap:8px;border:1px solid var(--border);border-radius:8px;padding:7px 9px;background:#fff}.team-card:hover{background:#f7f9fa}.team-logo,.team-placeholder{width:30px;height:30px;object-fit:contain;flex-shrink:0}.team-placeholder{border-radius:50%;background:#e8edf0;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;color:#65727d}.team-card-info{min-width:100px}.team-card-name{display:block;font-size:12px;font-weight:800}.team-card-short{font-size:9px;color:var(--muted)}.edit-team{background:transparent;color:var(--muted);padding:5px}
.history-panel{padding:0;overflow:hidden}.history-panel>.panel-heading{padding:20px;margin:0;border-bottom:1px solid var(--border)}.matrix-wrapper{width:100%;overflow:auto;max-height:calc(100vh - 250px)}.matrix{display:grid;width:max-content;grid-auto-rows:auto}.corner-cell,.year-header,.division-label,.table-cell{border-right:1px solid var(--border);border-bottom:1px solid var(--border)}
.corner-cell{width:150px;min-width:150px;height:54px;background:#17202a;color:#fff;position:sticky;left:0;top:0;z-index:20;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800}.year-header{height:54px;background:#263543;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;position:sticky;top:0;z-index:10}.division-label{width:150px;min-width:150px;min-height:210px;background:#edf0f3;padding:15px;position:sticky;left:0;z-index:8}.division-label strong{font-size:15px}.division-label span{display:block;color:var(--muted);font-size:10px;margin-top:4px}
.table-cell{width:360px;min-width:360px;min-height:210px;background:#fff;padding:10px}.cell-header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);padding:0 0 7px;margin-bottom:6px}.cell-header strong{font-size:10px;color:var(--muted)}.small-btn{background:#fff;border:1px solid var(--border);border-radius:4px;padding:3px 6px;font-size:9px;color:#63717d}
.standings{width:100%;border-collapse:collapse;font-size:11px}.standings th{padding:6px 4px;text-align:left;color:var(--muted);font-size:9px;border-bottom:1px solid var(--border)}.standings th:nth-last-child(-n+3),.standings td.points,.standings td.movement{text-align:center}.team-row{border-bottom:1px solid #edf0f2}.team-row td{padding:6px 3px}.team-row.promoted{background:#e7f7ee}.team-row.relegated{background:#fdeaea}.position{width:22px;color:var(--muted);font-weight:800}.team-info{display:flex;align-items:center;gap:6px}.standing-logo,.standing-placeholder{width:24px;height:24px;object-fit:contain;flex-shrink:0}.standing-placeholder{border-radius:50%;background:#e8edf0;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:800;color:#65727d}.team-name{font-weight:800;line-height:1.1}.team-short{display:block;font-size:8px;color:var(--muted);margin-top:2px}.competition-markers{display:flex;gap:2px;margin-left:3px}.badge{width:17px;height:17px;border-radius:4px;color:#fff;font-size:8px;font-weight:900;display:inline-flex;align-items:center;justify-content:center}.champions{background:var(--blue)}.europa{background:var(--yellow)}.conference{background:var(--conference)}.points{font-weight:900;color:var(--primary);cursor:pointer}.movement{width:24px}.movement-btn{width:22px;height:22px;border-radius:4px;font-size:12px}.promote-btn{background:#e7f7ee;color:var(--green)}.relegate-btn{background:#fdeaea;color:var(--red)}.empty-cell{height:175px;display:flex;align-items:center;justify-content:center;text-align:center;color:#a0aab3;font-size:11px}.empty-cell span{display:block;margin-top:5px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.full{grid-column:1/-1}.subheading{font-size:13px;margin:22px 0 10px}.competition-options{display:flex;flex-direction:column;gap:8px}.competition-options label{border:1px solid var(--border);border-radius:7px;padding:9px;font-size:12px;display:flex;align-items:center;gap:8px}
@media(max-width:1100px){.toolbar-actions{width:100%}.toolbar-actions button{flex:1}}@media(max-width:900px){.stats-row{grid-template-columns:repeat(2,1fr)}.appearance-form{grid-template-columns:1fr 1fr}.form-button{width:100%}.system-toolbar{align-items:flex-start;flex-direction:column}}@media(max-width:600px){.system-main{padding:12px}.brand-area{align-items:flex-start;flex-direction:column;gap:5px}.stats-row{grid-template-columns:1fr 1fr}.appearance-form{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.full{grid-column:auto}}

.history-stats{overflow:auto}.stats-table{width:100%;border-collapse:collapse;font-size:11px;min-width:720px}.stats-table th,.stats-table td{padding:9px 8px;border-bottom:1px solid var(--border);text-align:center}.stats-table th{font-size:9px;color:var(--muted);text-transform:uppercase}.stats-table th:first-child,.stats-table td:first-child,.stats-table th:nth-child(2),.stats-table td:nth-child(2){text-align:left}.empty-stats{padding:25px;text-align:center;color:var(--muted);font-size:12px}.cell-tabs-wrap{min-width:0}.cell-tabs{display:flex;gap:3px;overflow-x:auto;padding-bottom:6px}.cell-tab{border:1px solid var(--border);background:#f5f7f8;color:#56636e;border-radius:5px;padding:5px 8px;font-size:9px;font-weight:800;white-space:nowrap}.cell-tab.active{background:#263543;color:#fff;border-color:#263543}.cell-tab.add-tab{font-size:12px;padding-left:7px;padding-right:7px}.knockout-tab{background:#fff4df;color:#8a6100}.placement-mini{font-size:9px;margin-left:3px}.knockout-head{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);padding-bottom:8px;margin-bottom:10px}.knockout-bracket{display:flex;flex-direction:column;gap:8px}.match-card{border:1px solid var(--border);border-radius:7px;background:#fafbfc;padding:7px;font-size:10px}.match-card>div{display:flex;justify-content:space-between;gap:8px;padding:4px}.ko-score{width:35px;border:1px solid var(--border);border-radius:4px;text-align:center}.knockout-team-picker{display:grid;grid-template-columns:1fr 1fr;gap:6px;max-height:220px;overflow:auto}.knockout-team-picker label{border:1px solid var(--border);padding:8px;border-radius:6px;font-size:11px}.modal-note{font-size:10px;color:var(--muted);margin-top:10px}.knockout-modal-content{width:min(620px,100%)}.delete-year-btn{width:20px;height:20px;border-radius:4px;background:rgba(255,255,255,.12);color:#fff;font-size:15px;line-height:20px;padding:0}.delete-year-btn:hover{background:#c93636;transform:none}.year-header{gap:8px}
.cell-header-actions{display:flex;gap:4px;align-items:center}.drag-handle{cursor:grab;color:#9aa5ad;font-size:12px}.team-row{cursor:default}.team-row.dragging{opacity:.45}.cell-tab.drop-target{outline:2px dashed var(--primary);background:#eaf2ff}.stats-details td{background:#f8fafb;padding:10px}.division-title-breakdown{display:flex;flex-wrap:wrap;gap:8px}.division-title-breakdown span{border:1px solid var(--border);border-radius:6px;padding:6px 8px;font-size:10px}.continue-create{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;margin-right:auto}.match-selects{display:grid;grid-template-columns:1fr auto 1fr;gap:5px;align-items:center}.match-selects select{min-width:0;border:1px solid var(--border);border-radius:4px;padding:4px;font-size:10px}.score-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:4px;margin-top:7px}.score-grid label{font-size:8px;color:var(--muted)}.score-grid input{width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:4px;padding:4px;font-size:10px}.match-actions{display:flex;gap:5px;margin-top:7px}.next-round-btn{width:100%;margin-top:8px}.import-team-picker{}.knockout-team-picker label{display:flex;align-items:center;gap:6px}.knockout-team-picker label img{width:20px;height:20px;object-fit:contain}.hidden{display:none!important}

.stats-table .titles-head{min-width:115px}.titles-cell{white-space:nowrap;text-align:center!important}.titles-cell>span{display:inline-block;min-width:22px;text-align:center}.titles-cell .stats-expand{margin-left:12px}.stats-head-action{display:inline-block;margin-left:12px;font-weight:700;text-transform:none;color:var(--muted)}
.knockout-slots{display:grid;grid-template-columns:1fr 1fr;gap:7px;max-height:320px;overflow:auto}.knockout-slot-label{display:flex;align-items:center;gap:7px;border:1px solid var(--border);border-radius:6px;padding:7px;font-size:10px}.knockout-slot-label select{min-width:0;flex:1;border:1px solid var(--border);border-radius:4px;padding:5px;font-size:10px}.bracket-team{width:100%;display:flex;align-items:center;gap:7px;border:1px solid var(--border);background:#fff;border-radius:6px;padding:6px;text-align:left;font-size:10px;cursor:pointer}.bracket-team:hover{border-color:var(--primary);background:#f7fbff}.bracket-team.winner{background:#e8f7ec;border-color:#5aa66a}.bracket-team.empty{opacity:.6;cursor:default}.knockout-logo{width:24px;height:24px;object-fit:contain;flex:0 0 24px}.knockout-placeholder{display:inline-flex;align-items:center;justify-content:center;border-radius:50%;background:#eef1f3;color:#56636e;font-size:8px;font-weight:800}.score-area{display:flex;flex-direction:column;gap:4px;padding:4px 0}.score-row{display:grid!important;grid-template-columns:1fr auto 1fr auto;align-items:center;gap:5px}.score-row input{width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:4px;padding:4px;text-align:center;font-size:10px}.score-hint{font-size:8px;color:var(--muted);text-align:center}.main-score{grid-template-columns:1fr auto 1fr auto!important}.match-card{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:6px;align-items:center}.match-card .score-area{min-width:0}.knockout-champion{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:10px;padding:8px;border:1px solid var(--border);border-radius:7px;background:#fff8df}.team-info-mini{display:flex;align-items:center;gap:7px}.import-team-option{display:flex!important;align-items:center!important}.import-team-option input{margin-right:3px}@media(max-width:700px){.knockout-slots{grid-template-columns:1fr}.match-card{grid-template-columns:1fr}.stats-head-action{display:none}}

.score-extra-actions{display:flex!important;justify-content:center!important;gap:5px!important;padding:2px 0!important}
